{
  "description": "Resolve config.json providers.<capability>.id to its adapter skill, its access type, and the canonical models it serves. Auth blocks name the ENV VAR to read; the registry never carries a credential.",
  "base_url": "https://pub-597aecbeb0f64dee8c8894e4da9a211c.r2.dev/r",
  "providers": {
    "atlas": {
      "name": "provider-atlas",
      "provider": "atlas",
      "title": "Atlas Cloud",
      "access": [
        "api_key"
      ],
      "capabilities": [
        "image",
        "video",
        "audio"
      ],
      "models": {
        "seedance_2_5": {
          "kind": "video",
          "verified": true,
          "native": {
            "t2v": "bytedance/seedance-2.5/text-to-video",
            "i2v": "bytedance/seedance-2.5/image-to-video",
            "ref": "bytedance/seedance-2.5/reference-to-video"
          },
          "duration_seconds": [
            4,
            30
          ]
        },
        "seedance_2_0": {
          "kind": "video",
          "verified": true,
          "native": {
            "t2v": "bytedance/seedance-2.0/text-to-video",
            "i2v": "bytedance/seedance-2.0/image-to-video",
            "ref": "bytedance/seedance-2.0/reference-to-video"
          },
          "duration_seconds": [
            4,
            15
          ]
        },
        "nano_banana_2": {
          "kind": "image",
          "verified": true,
          "native": {
            "t2i": "google/nano-banana-2/text-to-image",
            "edit": "google/nano-banana-2/edit"
          }
        },
        "seed_audio_1_0": {
          "kind": "audio",
          "verified": true,
          "native": "bytedance/seed-audio-1.0"
        }
      },
      "gaps": {
        "gpt_image_2": "Not offered. Storyseam's default image model is Higgsfield-only; on Atlas use nano_banana_2."
      },
      "auth": {
        "api_key": {
          "env": "ATLAS_KEY",
          "header": "Authorization: Bearer $ATLAS_KEY",
          "base_url": "https://api.atlascloud.ai/api/v1",
          "obtain": "https://www.atlascloud.ai — create an account, then copy the API key from settings",
          "note": "Storyseam never reads, stores or prints the key. It checks only that the env var is set."
        }
      },
      "url": "https://pub-597aecbeb0f64dee8c8894e4da9a211c.r2.dev/r/providers/provider-atlas.json",
      "sha256": "a2a70cd278f1dfbc",
      "updated": "2026-09-02"
    },
